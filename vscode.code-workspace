{
	"folders": [
		{
			"name": "opinionated-dev-spaces",
			"path": "/projects/opinionated-dev-spaces"
		},
		{
			"name": "cekit-image-library",
			"path": "/projects/cekit-image-library"
		},
		{
			"name": "kamarotos",
			"path": "/projects/kamarotos"
		}
	],
	"extensions": {
		"recommendations": [
			"dbaeumer.vscode-eslint",
			"redhat.vscode-yaml",
			"ms-kubernetes-tools.vscode-kubernetes-tools",
			"mhutchie.git-graph",
			"eamodio.gitlens",
			"streetsidesoftware.code-spell-checker",
			"johnpapa.winteriscoming",
			"sst-dev.opencode",
			"zoocodeorganization.zoo-code",
			"kilocode.kilo-code",
			"cnshenj.vscode-task-manager"
		]
	},
	"settings": {
		"workbench.colorTheme": "Winter is Coming (Light)",
		"workbench.preferredDarkColorTheme": "Winter is Coming (Dark Blue)",
		"workbench.preferredLightColorTheme": "Winter is Coming (Light)",
		"editor.wordWrap": "on",
		"files.autoSave": "off",
		"zoo-code.autoImportSettingsPath": "/globalconfig/zoo-code-settings.json",
		"chat.disableAIFeatures": false,
		"kilo-code.new.autocomplete.enableAutoTrigger": false,
		"kilo-code.new.autocomplete.enableChatAutocomplete": false,
		"kilo-code.new.autocomplete.enableSmartInlineTaskKeybinding": false,
		"kilo-code.new.browserAutomation.enabled": false,
		"kilo-code.new.browserAutomation.headless": false,
		"kilo-code.new.browserAutomation.useSystemChrome": false,
		"kilo-code.new.model.providerID": "asus-gx10",
		"kilo-code.new.model.modelID": "nemotron-3-super",
		"yaml.kubernetesCRDStore.enable": true
	}
}