FROM registry.access.redhat.com/ubi10
ARG USER_HOME_DIR="/projects"

ENV HOME=${USER_HOME_DIR}
ENV BUILDAH_ISOLATION=chroot

USER 0

COPY --chown=0:0 entrypoint.sh /
COPY --chown=0:0 centos.repo /etc/yum.repos.d/
COPY --chown=0:0 dschrome /usr/local/bin/dschrome

RUN dnf --disableplugin=subscription-manager install -y procps-ng openssl git tar shadow-utils bash zsh mesa-dri-drivers xorg-x11-server-Xwayland util-linux vim-minimal vim-enhanced google-chrome-stable podman dbus-x11 ; \
    dnf install -y https://dl.fedoraproject.org/pub/epel/epel-release-latest-10.noarch.rpm ; \
    dnf install -y https://github.com/kasmtech/KasmVNC/releases/download/v1.5.2/kasmvncserver_fedora_42_1.5.2_x86_64.rpm ; \
    # dnf update -y ; \
    dnf clean all ; \
    # dnf clean cache ; \
    # pip3 install podman-compose ; \
    chmod +x /entrypoint.sh ; \
    chmod 755 /usr/local/bin/dschrome ; \
    ##
    ## Setup for root-less podman
    ##
    # Create the User's home directory
    mkdir -p ${USER_HOME_DIR} ; \
    #
    # Add the user to /etc/passwd and /etc/group
    # Add the user with the UID that the SCC will enforce
    groupadd -g 1000 user ; \
    useradd -u 1000 -g 1000 -d ${USER_HOME_DIR} -s /bin/bash user  ; \
    usermod -L user  ; \
    chmod 400 /etc/shadow  ; \
    chown -R 1000:1000 ${USER_HOME_DIR} ; \
    #
    # Enable podman to create uid and gid maps for the user
    chown root:user /etc/subuid /etc/subgid ; \
    chmod 664 /etc/subuid /etc/subgid ; \
    setcap cap_setuid+ep /usr/bin/newuidmap ; \
    setcap cap_setgid+ep /usr/bin/newgidmap ; \
    #
    # Chrome Setup
    chmod 644 /etc/pki/tls/private/kasmvnc.pem ; \
    rm -f /var/lib/dbus/machine-id /etc/machine-id ; \
    dbus-uuidgen --ensure=/etc/machine-id ; \
    mkdir -p /var/lib/dbus ; \
    ln -sf /etc/machine-id /var/lib/dbus/machine-id

# The SCC that we are using will ensure that the user runs as UID 1000 in its own user namespace on the host node.
USER 1000
WORKDIR ${USER_HOME_DIR}
# Using catatonit ensures that our running container has a process reaper.  This avoids zombie processes in the container.
ENTRYPOINT ["/usr/libexec/podman/catatonit","--","/entrypoint.sh"]
CMD [ "tail", "-f", "/dev/null" ]